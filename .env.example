# Optional Google sign-in. Copy to .env and fill all three together to enable.
# Keep .env private. Never put the client secret in mobile configuration or Git.
TAXI_AI_GOOGLE_CLIENT_ID=
TAXI_AI_GOOGLE_CLIENT_SECRET=
TAXI_AI_GOOGLE_REDIRECT_URI=
# Comma-separated iOS and Android OAuth client IDs; leave empty for web only.
TAXI_AI_GOOGLE_NATIVE_CLIENT_IDS=
# Optional absolute database path. Use the same configuration for all commands.
# TAXI_AI_DB=/absolute/path/to/taxi-ai.sqlite

# Driver invitations: sequential (default), batch, or legacy list/claim behavior.
# Road pickup estimates reuse existing map configuration; see docs/dispatch.md.
TAXI_AI_DISPATCH_MODE=sequential

# Optional verification/recovery emails. Keep off until a sender is configured.
# SMTP uses verified TLS on port 465 or required STARTTLS on 587.
TAXI_AI_EMAIL_MODE=off
TAXI_AI_SMTP_HOST=
TAXI_AI_SMTP_PORT=
TAXI_AI_SMTP_USER=
TAXI_AI_SMTP_PASSWORD=
TAXI_AI_SMTP_FROM=

# Optional native phone alerts. The inbox works with push disabled.
TAXI_AI_PUSH_ENABLED=false
TAXI_AI_EXPO_PROJECT_ID=
# Server-only credential when Expo enhanced push security is enabled.
TAXI_AI_EXPO_ACCESS_TOKEN=

# Optional vehicle photo analysis. Server only; never use EXPO_PUBLIC_ for this key.
TAXI_AI_VEHICLE_VISION_MODE=off
TAXI_AI_VEHICLE_VISION_API_KEY=
TAXI_AI_VEHICLE_VISION_MODEL=gpt-4.1-mini-2025-04-14

# Optional real safety-alert gateway; leave empty for no external delivery.
# Gateway must honor Idempotency-Key and the contract in docs/safety-monitoring.md.
SAFETY_ALERT_GATEWAY_URL=
SAFETY_ALERT_GATEWAY_TOKEN=
# Set these only for an agreed, connected emergency-service partner.
SAFETY_EMERGENCY_SERVICE_NAME=
SAFETY_EMERGENCY_SERVICE_ENABLED=false

# Optional Google sign-in. Copy to .env and fill all three together to enable.
# Keep .env private. Never put the client secret in mobile configuration or Git.
TAXI_AI_GOOGLE_CLIENT_ID=
TAXI_AI_GOOGLE_CLIENT_SECRET=
TAXI_AI_GOOGLE_REDIRECT_URI=
# Comma-separated iOS and Android OAuth client IDs; leave empty for web only.
TAXI_AI_GOOGLE_NATIVE_CLIENT_IDS=
# Optional absolute database path. Use the same configuration for all commands.
# TAXI_AI_DB=/absolute/path/to/taxi-ai.sqlite

# Optional passenger-only pause and rectangular test area (minLat,minLng,maxLat,maxLng).
# Hosted staging defaults to paused and requires bounds before unpausing.
TAXI_AI_RIDES_PAUSED=false
TAXI_AI_RIDE_PILOT_BOUNDS=

# Driver invitations: sequential (default), batch, or legacy list/claim behavior.
# Road pickup estimates reuse existing map configuration; see docs/dispatch.md.
TAXI_AI_DISPATCH_MODE=sequential
# 0 disables profiling. Set 10 to sample every tenth dispatch cycle. No SQL values or locations are logged.
TAXI_AI_DISPATCH_PROFILE_SAMPLE_EVERY=0
# Opt in after migrating PostgreSQL; false restores the original matching path.
TAXI_AI_MATCHING_FAST_PATH=false
# Optional comma-separated dispatch region IDs; empty selects all regions.
TAXI_AI_MATCHING_FAST_REGIONS=

# Optional verification/recovery emails. Keep off until a sender is configured.
# SMTP uses verified TLS on port 465 or required STARTTLS on 587.
TAXI_AI_EMAIL_MODE=off
TAXI_AI_SMTP_HOST=
TAXI_AI_SMTP_PORT=
TAXI_AI_SMTP_USER=
TAXI_AI_SMTP_PASSWORD=
TAXI_AI_SMTP_FROM=

# Optional native phone alerts. The inbox works with push disabled.
TAXI_AI_PUSH_ENABLED=false
TAXI_AI_EXPO_PROJECT_ID=
# Server-only credential when Expo enhanced push security is enabled.
TAXI_AI_EXPO_ACCESS_TOKEN=

# Optional vehicle photo analysis. Server only; never use EXPO_PUBLIC_ for this key.
TAXI_AI_VEHICLE_VISION_MODE=off
TAXI_AI_VEHICLE_VISION_API_KEY=
TAXI_AI_VEHICLE_VISION_MODEL=gpt-4.1-mini-2025-04-14

# Automatic driver selfie-to-licence comparison. Off until an AWS account is ready.
# This checks face similarity, not liveness or licence authenticity. See docs/driver-face-checks.md.
TAXI_DRIVER_FACE_PROVIDER=off
# Set the AWS region you have chosen for processing driver images when enabling.
# AWS_REGION=
TAXI_DRIVER_FACE_THRESHOLD=99
TAXI_DRIVER_FACE_TIMEOUT_MS=15000
# AWS SDK uses the server's IAM role/default credential chain. Never put AWS secrets
# in EXPO_PUBLIC_, browser scripts, Git, or mobile configuration.

# Optional real safety-alert gateway; leave empty for no external delivery.
# Gateway must honor Idempotency-Key and the contract in docs/safety-monitoring.md.
SAFETY_ALERT_GATEWAY_URL=
SAFETY_ALERT_GATEWAY_TOKEN=
# Set these only for an agreed, connected emergency-service partner.
SAFETY_EMERGENCY_SERVICE_NAME=
SAFETY_EMERGENCY_SERVICE_ENABLED=false

# Scale deployment: keep unset for one-process local SQLite development.
# Apply migrations explicitly before starting PostgreSQL API/worker replicas.
# TAXI_AI_DATABASE_URL=postgresql://taxi_app:CHANGE_ME@localhost:5432/taxi_ai
# TAXI_AI_DATABASE_POOL_SIZE=10
TAXI_AI_PROCESS_ROLE=all
# TAXI_AI_WORKER_REGIONS=auto
# TAXI_AI_WORKER_CONCURRENCY=4
# TAXI_AI_WORKER_LEASE_MS=15000
# Dedicated routing capacity requires provisioned endpoints; community limits stay fixed.
# TAXI_AI_MAPS_REQUESTS_PER_SECOND=3
# TAXI_AI_MAPS_MAX_CONCURRENT=4
# Optional Photon-compatible Eats reverse lookup, used only after Use current location.
# Dedicated maps require an explicit reverse endpoint; unset keeps manual address entry.
# TAXI_AI_REVERSE_URL=https://maps.example.test/reverse

# Staff authenticator: generate once with openssl rand -hex 32 and protect/back up the key.
# All API instances must use the same persistent key. Enrolled staff always require a code.
TAXI_AI_STAFF_MFA_KEY=
TAXI_AI_STAFF_MFA_REQUIRED=false

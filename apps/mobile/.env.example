# Public configuration only. Never put passwords, preview keys or API secrets here.
# Local development: Android emulator can use adb reverse tcp:3000 tcp:3000 first.
EXPO_PUBLIC_API_ORIGIN=http://127.0.0.1:3000
# Signed production-acceptance builds must override this in the EAS preview environment with:
# EXPO_PUBLIC_API_ORIGIN=https://taxiai.app
# Optional public Expo project UUID; must match the server. Rebuild to enable phone alerts.
# EXPO_PUBLIC_EXPO_PROJECT_ID=00000000-0000-4000-8000-000000000000
# Android Firebase client configuration path (or EAS file environment variable).
# GOOGLE_SERVICES_JSON=./google-services.json
# Google Maps SDK for Android only; set this in the EAS preview environment.
# Restrict the embedded SDK key to the app package/signing SHA-1 and Maps SDK for Android.
# iOS uses native Apple Maps and needs no Google Maps key. Rebuild after changing.
# GOOGLE_MAPS_ANDROID_API_KEY=
# Public OAuth IDs only. Native Google sign-in requires a development build.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client.apps.googleusercontent.com

# Signed acceptance build requirements (set in the EAS preview environment, not committed here):
# - EXPO_PUBLIC_API_ORIGIN=https://taxiai.app
# - EXPO_PUBLIC_EXPO_PROJECT_ID=<Taxi Ai EAS project UUID>
# - EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<same public web OAuth client used by the backend>
# - EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<iOS OAuth client ID>
# - GOOGLE_MAPS_ANDROID_API_KEY=<restricted Android Maps SDK key>
# - GOOGLE_SERVICES_JSON=<EAS file variable containing Android google-services.json>
# Apple signing/APNs and Android signing/FCM service-account credentials belong in EAS Credentials, never this file.

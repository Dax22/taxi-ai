{
  "name": "@taxi-ai/mobile",
  "version": "0.8.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "export": "expo export --platform ios --platform android",
    "verify": "npm run check && npm run typecheck && npm test && npm run export",
    "check": "node ../../scripts/check-mobile.mjs"
  },
  "dependencies": {
    "expo": "57.0.24",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.19",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-nitro-google-signin": "2.3.0",
    "react-native-nitro-modules": "0.36.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "typescript": "~6.0.2"
  },
  "type": "module"
}

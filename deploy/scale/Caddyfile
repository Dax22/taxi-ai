{
  admin off
}

{$TAXI_AI_DOMAIN} {
  @health path /health/*
  respond @health 404
  reverse_proxy api-a:3000 api-b:3000 {
    lb_policy least_conn
    lb_try_duration 5s
    lb_try_interval 250ms
    lb_retry_match {
      method GET HEAD
    }
    fail_duration 10s
    max_fails 1
    unhealthy_status 5xx
    flush_interval -1
    transport http {
      dial_timeout 3s
      response_header_timeout 35s
    }
    header_up Host {$TAXI_AI_DOMAIN}
    header_up X-Taxi-Ai-Proxy-Token {$TAXI_AI_PROXY_TOKEN}
    header_up X-Forwarded-Proto https
    header_up X-Forwarded-For {remote_host}
    header_up -Forwarded
  }
}

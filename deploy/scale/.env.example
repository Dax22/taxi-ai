# Copy to .env, chmod 600, and fill in values. Never commit real credentials.
# This remains an invited staging environment with no live external deliveries.
TAXI_AI_DOMAIN=taxi-scale.example.com
# Rectangle for the approved passenger test area; leave requests paused by default.
TAXI_AI_RIDES_PAUSED=true
TAXI_AI_RIDE_PILOT_BOUNDS=
# Generate each secret separately using: openssl rand -hex 32
TAXI_AI_PROXY_TOKEN=
TAXI_AI_APP_DATABASE_PASSWORD=
TAXI_AI_MIGRATION_DATABASE_PASSWORD=
TAXI_AI_DATABASE_POOL_SIZE=10
TAXI_AI_DISPATCH_MODE=sequential
TAXI_AI_WORKER_CONCURRENCY=4
# Use dedicated only after provisioning reviewed Photon/OSRM/XYZ capacity.
TAXI_AI_MAPS_MODE=off
TAXI_AI_SEARCH_URL=
TAXI_AI_ROUTING_URL=
TAXI_AI_TILE_URL=
TAXI_AI_MAPS_API_KEY=
# Per process: total all API and worker budgets must fit the provider contract.
TAXI_AI_MAPS_REQUESTS_PER_SECOND=3
TAXI_AI_MAPS_MAX_CONCURRENT=4

# Staff authenticator: generate once with openssl rand -hex 32 and protect/back up the key.
# All API instances must use the same persistent key. Enrolled staff always require a code.
TAXI_AI_STAFF_MFA_KEY=
TAXI_AI_STAFF_MFA_REQUIRED=false

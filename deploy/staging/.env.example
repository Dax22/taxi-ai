# Copy to .env on the selected host. Never commit real values.
TAXI_AI_DOMAIN=taxi-staging.example.com
# Generate 32 random bytes as 64 lowercase hex characters; do not reuse tester keys.
TAXI_AI_PROXY_TOKEN=
TAXI_AI_DB_PATH=/data/taxi-ai.sqlite
# Enable community maps only for a small, reviewed test group.
TAXI_AI_MAPS_MODE=off
# Cross-network calls need a provisioned/tested TURN relay.
TAXI_AI_CALLS_MODE=off
TAXI_AI_TURN_URLS=
TAXI_AI_TURN_SECRET=

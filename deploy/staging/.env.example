# Copy to .env on the selected host. Never commit real values.
TAXI_AI_DOMAIN=taxi-staging.example.com
# Hosted passenger requests stay paused until a reviewed test area is configured.
# Rectangle: minLat,minLng,maxLat,maxLng. Choose your own approved test area.
TAXI_AI_RIDES_PAUSED=true
TAXI_AI_RIDE_PILOT_BOUNDS=
# Generate 32 random bytes as 64 lowercase hex characters; do not reuse tester keys.
TAXI_AI_PROXY_TOKEN=
TAXI_AI_DB_PATH=/data/taxi-ai.sqlite
# Enable community maps only for a small, reviewed test group.
TAXI_AI_MAPS_MODE=off
# Cross-network calls need a provisioned/tested TURN relay.
TAXI_AI_CALLS_MODE=off
TAXI_AI_TURN_URLS=
TAXI_AI_TURN_SECRET=
# Optional Google OAuth. Use the exact HTTPS origin and /auth/google/callback.
TAXI_AI_GOOGLE_CLIENT_ID=
TAXI_AI_GOOGLE_CLIENT_SECRET=
TAXI_AI_GOOGLE_REDIRECT_URI=
TAXI_AI_GOOGLE_NATIVE_CLIENT_IDS=
# Account emails; configure a verified sender, never personal account passwords.
TAXI_AI_EMAIL_MODE=off
TAXI_AI_SMTP_HOST=
TAXI_AI_SMTP_PORT=
TAXI_AI_SMTP_USER=
TAXI_AI_SMTP_PASSWORD=
TAXI_AI_SMTP_FROM=
# Phone alerts: enable only after configuring the same Expo project in the app.
TAXI_AI_PUSH_ENABLED=false
TAXI_AI_EXPO_PROJECT_ID=
# Backend only; needed when Expo enhanced push security is enabled.
TAXI_AI_EXPO_ACCESS_TOKEN=
# Optional server-only vehicle vision. Build and validate the camera flow first.
TAXI_AI_VEHICLE_VISION_MODE=off
TAXI_AI_VEHICLE_VISION_API_KEY=
TAXI_AI_VEHICLE_VISION_MODEL=gpt-4.1-mini-2025-04-14

# Staff authenticator: generate once with openssl rand -hex 32 and protect/back up the key.
# All API instances must use the same persistent key. Enrolled staff always require a code.
TAXI_AI_STAFF_MFA_KEY=
TAXI_AI_STAFF_MFA_REQUIRED=false

# Optional Paystack TEST checkout. Live keys are rejected. See docs/paystack.md.
# Keep the test key configured when pausing new checkout, so existing payments reconcile.
TAXI_AI_PAYMENT_PROVIDER=off
PAYSTACK_SECRET_KEY=

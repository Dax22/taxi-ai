# Copy to .env on EACH host, chmod 600. This file is also loaded by app/worker.
# Never commit credentials or publish `docker compose config` output.
# Build the repository's Dockerfile once; use the SAME release on both hosts.
# Prefer repository@sha256:... references. No implicit latest image is used.
TAXI_AI_IMAGE=
TAXI_AI_POSTGRES_IMAGE=
TAXI_AI_CADDY_IMAGE=

TAXI_AI_DOMAIN=taxi-pilot.example.com
TAXI_AI_PROXY_TOKEN=
TAXI_AI_DB_ROLE=primary
# Replace examples with the actual two privately interconnected host addresses.
TAXI_AI_PRIVATE_IP=10.0.0.10
TAXI_AI_REPLICATION_PEER_IP=10.0.0.11
TAXI_AI_PRIMARY_PRIVATE_IP=10.0.0.10
TAXI_AI_DOCKER_SUBNET=172.28.0.0/24

# Database credentials are separate 64-hex-character files in secrets/:
# postgres-owner-password, postgres-app-password, postgres-replication-password.
# Keep both hosts' passwords identical; see README for permissions and TLS.
TAXI_AI_DATABASE_POOL_SIZE=10
TAXI_AI_RIDES_PAUSED=true
TAXI_AI_RIDE_PILOT_BOUNDS=
TAXI_AI_DISPATCH_MODE=sequential
TAXI_AI_DISPATCH_PROFILE_SAMPLE_EVERY=0
TAXI_AI_MATCHING_FAST_PATH=false
TAXI_AI_MATCHING_FAST_REGIONS=
TAXI_AI_WORKER_CONCURRENCY=2

# Copy existing, reviewed provider values before migration. These defaults are
# for a new unconfigured pilot, not instructions to disable existing services.
TAXI_AI_MAPS_MODE=off
TAXI_AI_SEARCH_URL=
TAXI_AI_REVERSE_URL=
TAXI_AI_ROUTING_URL=
TAXI_AI_TILE_URL=
TAXI_AI_MAPS_API_KEY=
TAXI_AI_MAPS_REQUESTS_PER_SECOND=1
TAXI_AI_MAPS_MAX_CONCURRENT=2
TAXI_AI_CALLS_MODE=off
TAXI_AI_TURN_URLS=
TAXI_AI_TURN_SECRET=
TAXI_AI_GOOGLE_CLIENT_ID=
TAXI_AI_GOOGLE_CLIENT_SECRET=
TAXI_AI_GOOGLE_REDIRECT_URI=
TAXI_AI_GOOGLE_NATIVE_CLIENT_IDS=
TAXI_AI_EMAIL_MODE=off
TAXI_AI_SMTP_HOST=
TAXI_AI_SMTP_PORT=
TAXI_AI_SMTP_USER=
TAXI_AI_SMTP_PASSWORD=
TAXI_AI_SMTP_FROM=
TAXI_AI_PUSH_ENABLED=false
TAXI_AI_EXPO_PROJECT_ID=
TAXI_AI_EXPO_ACCESS_TOKEN=
TAXI_AI_VEHICLE_VISION_MODE=off
TAXI_AI_VEHICLE_VISION_API_KEY=
TAXI_AI_VEHICLE_VISION_MODEL=gpt-4.1-mini-2025-04-14
TAXI_DRIVER_FACE_PROVIDER=off
TAXI_DRIVER_FACE_THRESHOLD=99
TAXI_DRIVER_FACE_TIMEOUT_MS=15000
# AWS_REGION=
SAFETY_ALERT_GATEWAY_URL=
SAFETY_ALERT_GATEWAY_TOKEN=
SAFETY_EMERGENCY_SERVICE_NAME=
SAFETY_EMERGENCY_SERVICE_ENABLED=false
TAXI_AI_STAFF_MFA_KEY=
TAXI_AI_STAFF_MFA_REQUIRED=false
# Current application accepts Paystack TEST keys only.
TAXI_AI_PAYMENT_PROVIDER=off
PAYSTACK_SECRET_KEY=
